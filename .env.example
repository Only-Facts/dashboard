# Copy this file to .env. Never commit .env.
# Generate with: openssl rand -hex 24
DB_PASSWORD=replace-with-a-long-random-password

# Host-only development ports. The normal full Docker stack does not expose PostgreSQL.
DB_HOST_PORT=5434
MAIL_SMTP_HOST_PORT=1026
MAIL_UI_PORT=8025

# GitHub OAuth is optional. Generate the encryption key with:
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/services/github/callback

FRONTEND_URL=http://localhost:8080

# Keep false for local HTTP. Set true behind HTTPS in production.
COOKIE_SECURE=false

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@dashboard.local
