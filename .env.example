# Copy this file to .env. Never commit .env.
# Generate with: openssl rand -hex 24
DB_PASSWORD=replace-with-a-long-random-password

# Host-only development ports. The normal full Docker stack does not expose PostgreSQL.
DB_HOST_PORT=5434
MAIL_SMTP_HOST_PORT=1026
MAIL_UI_PORT=8025

TOKEN_ENCRYPTION_KEY=

# Twitch OAuth is optional.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CALLBACK_URL=http://127.0.0.1:8080/api/services/twitch/callback

FRONTEND_URL=http://127.0.0.1:8080

# Keep false for local HTTP. Set true behind HTTPS in production.
COOKIE_SECURE=false

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@dashboard.local

# Spotify OAuth: use 127.0.0.1 for local login and callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CALLBACK_URL=http://127.0.0.1:8080/api/services/spotify/callback
