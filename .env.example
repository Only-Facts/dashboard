# Copy to .env. Generate a password with: openssl rand -hex 24
DB_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -base64 32 (required only for GitHub)
TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/services/github/callback
FRONTEND_URL=http://localhost:8080
# Set true behind HTTPS in production.
COOKIE_SECURE=false
# Local Compose uses Mailpit. For production set your real SMTP values.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@dashboard.local
